# Base de datos (SQLite local; la ruta es relativa a la carpeta prisma/)
DATABASE_URL="file:./dev.db"

# Negocio (config compartida por todas las sucursales de este deploy — el
# nombre, dirección, login de admin y credenciales de GHL de cada barbería
# viven en la tabla Branch, no acá)
BUSINESS_TIMEZONE="America/Mexico_City"
DEFAULT_COUNTRY_CODE="+52"
BOOKING_HORIZON_DAYS=60
MIN_LEAD_MINUTES=60
SLOT_STEP_MINUTES=15

# GoHighLevel — solo config de API compartida. Cada sucursal conecta su propia
# sub-cuenta (apiKey, locationId, calendarId, webhookSecret) desde el panel
# admin o directo en la base de datos; si faltan, esa sucursal opera en modo
# mock automáticamente.
GHL_API_BASE="https://services.leadconnectorhq.com"
GHL_API_VERSION="2021-04-15"
