# Base de datos (SQLite local; la ruta es relativa a la carpeta prisma/)
DATABASE_URL="file:./dev.db"

# Negocio
BUSINESS_TIMEZONE="America/Mexico_City"
BUSINESS_NAME="Barbería La Navaja"
DEFAULT_COUNTRY_CODE="+52"
BOOKING_HORIZON_DAYS=60
MIN_LEAD_MINUTES=60
SLOT_STEP_MINUTES=15

# Admin (login del panel)
ADMIN_USER="admin"
ADMIN_PASSWORD="barberia123"

# GoHighLevel
# GHL_MODE=mock  -> calendario simulado local (tabla GhlEvent). No requiere credenciales.
# GHL_MODE=live  -> llamadas HTTP reales a la API v2 de GHL.
#                   Si falta GHL_API_KEY, GHL_LOCATION_ID o GHL_CALENDAR_ID,
#                   la app hace fallback automático a mock (nunca crashea).
GHL_MODE="mock"
GHL_API_KEY=""
GHL_LOCATION_ID=""
GHL_CALENDAR_ID=""
GHL_API_BASE="https://services.leadconnectorhq.com"
GHL_API_VERSION="2021-04-15"
GHL_WEBHOOK_SECRET="dev-webhook-secret"
