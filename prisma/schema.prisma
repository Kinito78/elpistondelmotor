generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Branch {
  id            String   @id @default(cuid())
  name          String
  timezone      String   @default("America/Mexico_City")
  address       String?
  phone         String?
  createdAt     DateTime @default(now())

  // Multi-tenant: identifica la sucursal por dominio propio o por subdominio
  // (slug). Ambos únicos y opcionales para no romper el modo single-tenant
  // de hoy (una sola fila, sin dominio configurado → siempre es "la activa").
  slug   String? @unique
  domain String? @unique

  // Login del panel admin, uno por sucursal. La contraseña se guarda hasheada
  // (scrypt), nunca en texto plano.
  adminUser         String  @default("admin")
  adminPasswordHash String

  // Credenciales de GHL por sucursal (antes vivían en variables de entorno
  // globales; cada barbería conecta su propia sub-cuenta).
  ghlApiKey        String?
  ghlLocationId    String?
  ghlCalendarId    String?
  ghlWebhookSecret String?

  // Programa de fidelidad: cada tantos cortes confirmados, un descuento en pesos.
  loyaltyCutsRequired Int @default(5)
  loyaltyRewardCents  Int @default(20000)
  loyaltyWindowDays   Int @default(5)

  barbers            Barber[]
  services           Service[]
  appointments       Appointment[]
  loyaltyVisits      LoyaltyVisit[]
  loyaltyRedemptions LoyaltyRedemption[]
  adminSessions      AdminSession[]
}

model Service {
  id          String   @id @default(cuid())
  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id])
  name        String
  description String?
  durationMin Int
  priceCents  Int
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  barbers      BarberService[]
  appointments Appointment[]

  @@index([branchId, active])
}

model Barber {
  id            String   @id @default(cuid())
  branchId      String
  branch        Branch   @relation(fields: [branchId], references: [id])
  name          String
  bio           String?
  photoUrl      String?
  active        Boolean  @default(true)
  ghlUserId     String?
  ghlCalendarId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  services     BarberService[]
  workingHours WorkingHour[]
  timeOff      TimeOff[]
  appointments Appointment[]

  @@index([branchId, active])
}

model BarberService {
  barberId  String
  serviceId String
  barber    Barber  @relation(fields: [barberId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([barberId, serviceId])
}

model WorkingHour {
  id       String  @id @default(cuid())
  barberId String
  barber   Barber  @relation(fields: [barberId], references: [id], onDelete: Cascade)
  weekday  Int
  startMin Int
  endMin   Int
  active   Boolean @default(true)

  @@unique([barberId, weekday])
}

model TimeOff {
  id       String   @id @default(cuid())
  barberId String
  barber   Barber   @relation(fields: [barberId], references: [id], onDelete: Cascade)
  startsAt DateTime
  endsAt   DateTime
  reason   String?

  @@index([barberId, startsAt])
}

model Customer {
  id           String   @id @default(cuid())
  name         String
  phone        String   @unique
  email        String?
  ghlContactId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  appointments       Appointment[]
  loyaltyVisits      LoyaltyVisit[]
  loyaltyRedemptions LoyaltyRedemption[]
}

model Appointment {
  id            String   @id @default(cuid())
  branchId      String
  branch        Branch   @relation(fields: [branchId], references: [id])
  barberId      String
  barber        Barber   @relation(fields: [barberId], references: [id])
  serviceId     String
  service       Service  @relation(fields: [serviceId], references: [id])
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id])
  startsAt      DateTime
  endsAt        DateTime
  status        String   @default("confirmed")
  source        String   @default("web")
  priceCents    Int
  paymentStatus String   @default("unpaid")
  notes         String?
  manageToken   String   @unique
  // Índice único parcial emulado (ver SPEC 4): "<barberId>|<startsAtISO>" mientras el
  // slot está ocupado (confirmed/completed), NULL cuando se libera (cancelled/no_show).
  // Garantiza que no existan dos citas confirmadas del mismo barbero en el mismo instante.
  slotKey       String?  @unique
  ghlEventId    String?  @unique
  ghlSyncStatus String   @default("pending")
  ghlSyncError  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  loyaltyVisit LoyaltyVisit?

  @@index([branchId, startsAt])
  @@index([startsAt, status])
  @@index([barberId, startsAt])
}

model LoyaltyVisit {
  id            String   @id @default(cuid())
  branchId      String
  branch        Branch   @relation(fields: [branchId], references: [id])
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id])
  appointmentId String?  @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])

  // "auto" (se crea al marcar una cita como completada) o "manual" (el barbero
  // registra un corte pagado fuera de la app, ej. efectivo sin reserva).
  source String

  // "pending" (esperando confirmación por WhatsApp) → "confirmed" (cuenta para
  // el premio) o "expired" (no se confirmó dentro de la ventana).
  status       String   @default("pending")
  confirmToken String   @unique
  createdAt    DateTime @default(now())
  confirmedAt  DateTime?
  expiresAt    DateTime

  // Si no es null, esta visita ya se usó para canjear un descuento y no vuelve
  // a contar en el progreso hacia el próximo.
  redemptionId String?
  redemption   LoyaltyRedemption? @relation(fields: [redemptionId], references: [id])

  @@index([customerId, branchId, status])
}

model LoyaltyRedemption {
  id            String   @id @default(cuid())
  branchId      String
  branch        Branch   @relation(fields: [branchId], references: [id])
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id])
  cutsUsed      Int
  discountCents Int
  createdAt     DateTime @default(now())

  visits LoyaltyVisit[]

  @@index([customerId, branchId])
}

model GhlEvent {
  id             String   @id @default(cuid())
  ghlEventId     String   @unique
  ghlCalendarId  String
  ghlContactId   String?
  assignedUserId String?
  barberId       String?
  title          String?
  startsAt       DateTime
  endsAt         DateTime
  status         String   @default("confirmed")
  origin         String   @default("web")
  raw            String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([ghlCalendarId, startsAt])
}

model AdminSession {
  token     String   @id
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id])
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([branchId])
}
